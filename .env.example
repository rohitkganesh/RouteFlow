# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=routeflow
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256-GCM)
ENCRYPTION_KEY=your-32-byte-base64-encoded-key-change-in-production
ENCRYPTION_IV_LENGTH=12

# Bcrypt
BCRYPT_ROUNDS=12

# CORS (comma-separated origins; in dev any localhost port is allowed)
CORS_ORIGIN=

# Routing API Configuration
# `osrm` (default) uses the free public OSRM API — no key needed.
# `google` uses the Google Maps Distance Matrix / Directions APIs (requires GOOGLE_MAPS_API_KEY).
# `mock` applies a road-distance factor to haversine straight-line distance (offline, no network).
ROUTING_PROVIDER=osrm
GOOGLE_MAPS_API_KEY=
OSRM_BASE_URL=http://router.project-osrm.org
ROUTING_MOCK_DELAY_MS=100
# Multiplier applied to straight-line (haversine) distance in `mock` mode to
# approximate road-network distance. Roads follow streets, so real road
# distance is typically 1.2–1.4× the great-circle distance in urban areas.
# The mock provider, auto-assign scoring, nearby-driver search, and
# route-typed backfill all use this factor when they fall back to haversine.
# Ignored when ROUTING_PROVIDER is `osrm` or `google` (those return real road distance).
ROUTING_ROAD_DISTANCE_FACTOR=1.25

# Twilio Configuration (SMS) - Get from https://console.twilio.com
# NOTE: SMS is OPTIONAL. The order-emails feature (Order Confirmed /
# Delivered) works without Twilio. Leave these blank if you don't
# need SMS notifications; the notificationService will skip SMS and
# only send email.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# =====================================================================
# Email Configuration (Nodemailer / SMTP)
# =====================================================================
# The backend sends two transactional emails per order:
#   1. "Order Confirmed - Track Your Delivery" — fired by
#      OrderService.create when a seller creates an order.
#   2. "Your Order Has Been Delivered!" — fired by
#      OrderService.updateOrderStatusTyped when status flips to DELIVERED.
# Both go to the customer's email address from the order form, which is
# why the seller create-order form now requires customerEmail.
#
# Provider: any SMTP server works. The defaults below match Gmail.
# For Gmail you MUST use an "App Password" (your normal account
# password is rejected). To make one:
#   1. Enable 2-Step Verification on the Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an app password for "Mail" / "Other (RouteFlow)".
#   4. Copy the 16-char password Google shows and paste it below.
#
# Variables (replace the placeholders with your real values):
SMTP_HOST=smtp.gmail.com              # e.g. smtp.gmail.com, smtp.office365.com, smtp.mailgun.org
SMTP_PORT=587                          # 587 for STARTTLS (recommended), 465 for implicit TLS
SMTP_USER=your-email@gmail.com         # the mailbox that authenticates against the SMTP server
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com  # the "From" address recipients will see
SMTP_FROM_NAME=RouteFlow               # the "From" display name recipients will see
# Optional alias names — the canonical SMTP_* values above are what
# notificationService reads. Leave these commented out unless you
# also rename the canonical ones.
# EMAIL_USER=
# EMAIL_PASS=

# Public App URL (used to build tracking links sent in notifications)
PUBLIC_APP_URL=http://localhost:3000

# Auto-Assign matching algorithm tuning
# MAX_DRIVER_WORKLOAD = cap on active orders a driver can hold; drivers
# at or above this count are skipped by the matching algorithm.
# WORKLOAD_DISTANCE_PENALTY_KM = how many "km of equivalent distance" each
# unit of current workload adds to a driver's score. Higher = workload
# dominates proximity. 2 means a driver 4km away with 0 orders beats one
# 1km away with 5 orders.
MAX_DRIVER_WORKLOAD=5
WORKLOAD_DISTANCE_PENALTY_KM=2

# Geofencing: radius (in meters) within which a driver pushing a
# location update triggers an auto-transition of any of their
# `on_the_way` orders to `delivered`. Set to 0 to disable. The check
# is a single SELECT + one haversine per active on_the_way order, so
# even tight values (10–25m) are cheap.
GEOFENCE_DELIVERY_RADIUS_METERS=50